generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Org {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      OrgPlan  @default(STARTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  users          User[]
  workOrders     WorkOrder[]
  lines          ProductionLine[]
  ncrs           Ncr[]
  suppliers      Supplier[]
  assets    Asset[]

  @@map("orgs")
}

enum OrgPlan {
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  name           String?
  image          String?
  role           UserRole  @default(PENDING)
  orgId          String?
  org            Org?      @relation(fields: [orgId], references: [id])
  approved       Boolean   @default(false)
  approvedAt     DateTime?
  approvedBy     String?
  rejectedAt     DateTime?
  rejectedReason String?
  registeredAt   DateTime  @default(now())
  lastLoginAt    DateTime?
  accounts       Account[]
  sessions       Session[]
  auditLogs      AuditLog[]
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  @@index([email])
  @@index([orgId])
  @@map("users")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ENGINEER
  VIEWER
  PENDING
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Asset {
  id          String   @id @default(cuid())
  name        String
  description String?
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id])
  vertical    String
  location    String?
  sensors     Sensor[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([orgId])
  @@map("assets")
}

model Sensor {
  id          String          @id @default(cuid())
  name        String
  type        String
  unit        String
  assetId     String
  asset       Asset           @relation(fields: [assetId], references: [id], onDelete: Cascade)
  mlAlgorithm String          @default("ensemble")
  config      Json            @default("{}")
  thresholds  Json            @default("{}")
  readings    SensorReading[]
  predictions Prediction[]
  alerts      Alert[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([assetId])
  @@map("sensors")
}

model SensorReading {
  id        String   @id @default(cuid())
  sensorId  String
  sensor    Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  value     Float
  quality   Float    @default(1.0)
  status    String   @default("OK")
  timestamp DateTime @default(now())

  @@index([sensorId, timestamp])
  @@map("sensor_readings")
}

model Prediction {
  id         String   @id @default(cuid())
  sensorId   String
  sensor     Sensor   @relation(fields: [sensorId], references: [id], onDelete: Cascade)
  algorithm  String
  predicted  Float
  confidence Float
  rulHours   Float?
  features   Json     @default("{}")
  timestamp  DateTime @default(now())

  @@index([sensorId, timestamp])
  @@map("predictions")
}

model Alert {
  id         String     @id @default(cuid())
  sensorId   String
  sensor     Sensor     @relation(fields: [sensorId], references: [id])
  severity   AlertLevel
  type       String
  message    String
  value      Float?
  threshold  Float?
  resolved   Boolean    @default(false)
  resolvedAt DateTime?
  createdAt  DateTime   @default(now())

  @@index([sensorId])
  @@index([resolved])
  @@map("alerts")
}

enum AlertLevel {
  INFO
  WARNING
  CRITICAL
}

model VisionJob {
  id          String         @id @default(cuid())
  name        String
  partNumber  String
  revision    String         @default("Rev A")
  cameraModel String         @default("CVX-2448-C")
  tool        String         @default("defect")
  sensitivity Int            @default(78)
  minDefectPx Int            @default(4)
  confidence  Int            @default(90)
  sessions    VisionSession[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@map("vision_jobs")
}

model VisionSession {
  id          String        @id @default(cuid())
  jobId       String
  job         VisionJob     @relation(fields: [jobId], references: [id])
  totalCount  Int           @default(0)
  passCount   Int           @default(0)
  failCount   Int           @default(0)
  avgCycleMs  Float         @default(0)
  results     VisionResult[]
  startedAt   DateTime      @default(now())
  endedAt     DateTime?

  @@index([jobId])
  @@map("vision_sessions")
}

model VisionResult {
  id          String        @id @default(cuid())
  sessionId   String
  session     VisionSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  result      String
  confidence  Float
  defectCount Int           @default(0)
  defectTypes Json          @default("[]")
  cycleMs     Float
  timestamp   DateTime      @default(now())

  @@index([sessionId, timestamp])
  @@map("vision_results")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  orgId      String?
  action     String
  resource   String?
  resourceId String?
  outcome    String   @default("success")
  metadata   Json     @default("{}")
  timestamp  DateTime @default(now())

  @@index([userId])
  @@index([orgId])
  @@index([timestamp])
  @@map("audit_logs")
}

// ── Work Orders ───────────────────────────────────────────────────────────────
model WorkOrder {
  id          String           @id @default(cuid())
  number      String
  partNumber  String
  customer    String?
  quantity    Int              @default(0)
  completed   Int              @default(0)
  status      WorkOrderStatus  @default(OPEN)
  priority    Int              @default(3)
  dueDate     DateTime?
  startedAt   DateTime?
  completedAt DateTime?
  orgId       String
  org         Org              @relation(fields: [orgId], references: [id])
  lineId      String?
  line        ProductionLine?  @relation(fields: [lineId], references: [id])
  createdBy   String?
  notes       String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([orgId])
  @@index([status])
  @@map("work_orders")
}

enum WorkOrderStatus {
  OPEN
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

// ── Production Lines ──────────────────────────────────────────────────────────
model ProductionLine {
  id          String      @id @default(cuid())
  name        String
  description String?
  orgId       String
  org         Org         @relation(fields: [orgId], references: [id])
  location    String?
  active      Boolean     @default(true)
  workOrders  WorkOrder[]
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([orgId])
  @@map("production_lines")
}

// ── NCRs ──────────────────────────────────────────────────────────────────────
model Ncr {
  id                String     @id @default(cuid())
  number            String
  partNumber        String
  customer          String?
  defectType        String?
  severity          String
  description       String?
  status            String     @default("OPEN")
  quantityAffected  Int        @default(0)
  workOrderId       String?
  orgId             String
  org               Org        @relation(fields: [orgId], references: [id])
  createdBy         String?
  closedAt          DateTime?
  closedBy          String?
  correctiveAction  String?
  rootCause         String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([orgId])
  @@index([status])
  @@map("ncrs")
}

// ── Suppliers ─────────────────────────────────────────────────────────────────
model Supplier {
  id             String          @id @default(cuid())
  name           String
  category       String?
  orgId          String
  org            Org             @relation(fields: [orgId], references: [id])
  otif           Float           @default(0)
  qualityPpm     Float           @default(0)
  score          Float           @default(0)
  rating         String          @default("APPROVED")
  contactName    String?
  contactEmail   String?
  country        String?
  currency       String          @default("USD")
  scars          Scar[]
  purchaseOrders PurchaseOrder[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([orgId])
  @@map("suppliers")
}

// ── SCARs ─────────────────────────────────────────────────────────────────────
model Scar {
  id          String    @id @default(cuid())
  number      String
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  issue       String
  severity    String    @default("MAJOR")
  status      String    @default("OPEN")
  d8Status    String?
  issuedAt    DateTime  @default(now())
  dueAt       DateTime?
  closedAt    DateTime?
  ncrId       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([supplierId])
  @@map("scars")
}

// ── Purchase Orders ───────────────────────────────────────────────────────────
model PurchaseOrder {
  id          String    @id @default(cuid())
  number      String
  supplierId  String
  supplier    Supplier  @relation(fields: [supplierId], references: [id])
  partNumber  String?
  description String?
  quantity    Int       @default(0)
  unitPrice   Float     @default(0)
  totalValue  Float     @default(0)
  currency    String    @default("USD")
  status      String    @default("OPEN")
  orderedAt   DateTime  @default(now())
  dueAt       DateTime?
  receivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([supplierId])
  @@map("purchase_orders")
}
