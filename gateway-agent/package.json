{
  "name": "corverxis-iiot-gateway-agent",
  "version": "1.0.0",
  "description": "On-prem IIoT gateway agent — reads sensor data locally and pushes it to CorverxisLab over HTTPS",
  "main": "agent.js",
  "scripts": {
    "start": "node agent.js",
    "start:simulate": "MODE=simulate node agent.js",
    "start:opcua": "MODE=opcua node agent.js"
  },
  "dependencies": {
    "aedes": "^0.51.3",
    "modbus-serial": "^8.0.25",
    "mqtt": "^5.15.2"
  },
  "optionalDependencies": {
    "node-opcua": "^2.126.0",
    "modbus-serial": "^8.0.0",
    "mqtt": "^5.0.0"
  },
  "engines": {
    "node": ">=18"
  }
}
